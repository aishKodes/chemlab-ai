Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(src|database|migrations|seeders|storage|vendor|scripts)(/.*)?$ - [F,L]
  RewriteRule ^(\.env|config\.php|composer\.(json|lock)|package(-lock)?\.json|README\.md)$ - [F,L]

  RewriteRule ^api(/.*)?$ index.php [QSA,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^$ index.php [QSA,L]
</IfModule>

<FilesMatch "^(\.env|config\.php|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
