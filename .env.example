NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_INTERNAL_API_URL=http://localhost:8000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Keys - server-side only
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b

# Backward-compatible legacy AI settings
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Main Chem-Shastri AI control
CHEM_SHASTRI_ENABLED=true
CHEM_SHASTRI_MOCK_MODE=false
CHEM_SHASTRI_DEFAULT_PROVIDER=gemini
CHEM_SHASTRI_FAST_PROVIDER=gemini
CHEM_SHASTRI_REASONING_PROVIDER=openai
CHEM_SHASTRI_OPENAI_FALLBACK_ENABLED=false
CHEM_SHASTRI_DAILY_BUDGET_INR=50
CHEM_SHASTRI_RETRIEVAL_ENABLED=true
CHEM_SHASTRI_NCERT_ONLY=true
CHEM_SHASTRI_KEYWORD_SEARCH=true
CHEM_SHASTRI_VECTOR_SEARCH=false
CHEM_SHASTRI_RETRIEVAL_TOP_K=6
CHEM_SHASTRI_SAFETY_MODE=strict
CHEM_SHASTRI_ALLOW_UNSAFE_CHEMISTRY_INSTRUCTIONS=false
CHEM_SHASTRI_VOICE_AUTO_SPEAK=false
MASTER_ALCHEM_ENABLED=true
MASTER_ALCHEM_MOCK_MODE=false
AI_COST_GUARD_ENABLED=true

# Daily budget
DAILY_AI_BUDGET_INR=50
AI_USD_TO_INR=90
STOP_AI_WHEN_BUDGET_EXCEEDED=true
WARN_AI_BUDGET_PERCENT=80

# AI Router
AI_DEFAULT_PROVIDER=gemini
AI_FAST_PROVIDER=gemini
AI_REASONING_PROVIDER=openai
AI_EMBEDDING_PROVIDER=gemini
OPENAI_FALLBACK_ENABLED=false

# Models - configurable
GEMINI_FAST_MODEL=gemini-1.5-flash
GEMINI_REASONING_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chem-Shastri Limits
ANONYMOUS_DAILY_AI_LIMIT=3
FREE_USER_DAILY_AI_LIMIT=10
TEST_USER_DAILY_AI_LIMIT=30
ADMIN_DAILY_AI_LIMIT=100

# RAG
RAG_ENABLED=true
RAG_USE_VECTOR_SEARCH=false
RAG_USE_KEYWORD_SEARCH=true
FAQ_SEMANTIC_SEARCH=false
RAG_TOP_K=6
RAG_RERANK_TOP_K=3
RAG_MAX_CONTEXT_CHARS=8000

# Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL_DAYS=30
EMBEDDING_CACHE_ENABLED=true

# Voice
VOICE_ENABLED=true
VOICE_DEFAULT_ENABLED=false
VOICE_DEFAULT_MODE=browser
PAID_TTS_ENABLED=false
VOICE_CACHE_ENABLED=true
VOICE_DAILY_BUDGET_INR=10
VOICE_AUTO_SPEAK=false

# Safety
CHEMISTRY_SAFETY_MODE=strict
ALLOW_UNSAFE_CHEMISTRY_INSTRUCTIONS=false

# Analytics
ANALYTICS_ENABLED=true
TRACK_AI_COSTS=true
TRACK_STUDENT_PROGRESS=true

# Local development helpers
DEV_UNLIMITED_AI=true
